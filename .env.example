# PocketLedger — build-time configuration
# Copy this file to `.env` and fill in the values before running `npm run build`.
# `.env` is git-ignored; never commit it.

# Checkout URL for the Premium upgrade button.
# Create a product and a checkout/payment link in your payment provider
# (e.g. Stripe Payment Link, Lemon Squeezy, Paddle), then paste YOUR link here.
# Leave empty until you have a real link — the app never substitutes a
# placeholder domain; without this, production builds honestly report that
# checkout is not configured.
VITE_UPGRADE_URL=

# One-time Premium price shown to users (number only, no currency symbol).
VITE_PREMIUM_PRICE=9.99

# Currency label shown next to the price (e.g. USD, EUR).
VITE_PREMIUM_CURRENCY=USD

# SECURITY: never put private API keys, secrets, or webhook credentials in
# VITE_* variables — everything prefixed with VITE_ is embedded in the
# public frontend bundle. Payment credentials belong on your provider's
# backend only.
